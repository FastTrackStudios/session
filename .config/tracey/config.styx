@schema {id crate:tracey-config@1, cli tracey}

specs (
    {
        name hello-world
        prefix r
        include (cells/hello-world/hello-world-proto/spec/**/*.md)
        impls (
            {
                name hello-world-proto
                include (cells/hello-world/hello-world-proto/src/**/*.rs)
            }
            {
                name hello-world
                include (cells/hello-world/hello-world/src/**/*.rs)
            }
        )
    }
)