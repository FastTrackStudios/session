@schema {id crate:tracey-config@1, cli tracey}

specs (
    {
        name example
        source_url https://git.starcommand.live/codywright/architect
        include (examples/app/features/example/spec/**/*.md)
        impls (
            {
                name live
                include (
                    examples/app/features/example/example-db/**/*.rs
                    examples/app/features/example/example-memory/**/*.rs
                )
                exclude (
                    examples/app/features/example/**/target/**
                )
                test_include (
                    examples/app/features/example/tests/**/*.rs
                )
            }
            {
                name mock
                include (
                    examples/external-stub/**/*.rs
                )
                exclude (
                    examples/external-stub/**/target/**
                )
                test_include (
                    examples/app/features/example/tests/**/*.rs
                )
            }
        )
    }
)
