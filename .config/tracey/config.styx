@schema {id crate:tracey-config@1, cli tracey}

specs (
    {
        name example
        source_url https://codeberg.org/FastTrackStudios/architect
        include (features/example/spec/**/*.md)
        impls (
            {
                name live
                include (
                    features/example/example-db/**/*.rs
                    features/example/example-memory/**/*.rs
                )
                exclude (
                    features/example/**/target/**
                )
                test_include (
                    features/example/tests/**/*.rs
                )
            }
            {
                name mock
                include (
                    examples/external-stub/**/*.rs
                )
                exclude (
                    examples/external-stub/**/target/**
                )
                test_include (
                    features/example/tests/**/*.rs
                )
            }
        )
    }

    {
        name foo
        include (features/foo/spec/**/*.md)
        impls (
            {
                name live
                include (
                    features/foo/foo-memory/**/*.rs
                )
                exclude (
                    features/foo/**/target/**
                )
                test_include (
                    features/foo/tests/**/*.rs
                )
            }
        )
    }

    {
        name bar
        include (features/bar/spec/**/*.md)
        impls (
            {
                name live
                include (
                    features/bar/bar-memory/**/*.rs
                )
                exclude (
                    features/bar/**/target/**
                )
                test_include (
                    features/bar/tests/**/*.rs
                )
            }
        )
    }
)
