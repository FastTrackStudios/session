  <Page name="mcp.strip">
    <Frame name="Strip" w=86 h=400>
      <Rectangle name="Ground" w=86 h=400 bind:w="w" bind:h="h" bind:fill="track.ground" />
      <Rectangle name="Edge" w=1 h=400 bind:h="h" bind:fill="track.edge" bind:visible="track.has_edge" />
      <Rectangle name="Selected" w=86 h=2 bind:fill="$accent" bind:w="w" bind:visible="track.selected && !ui.rack" />
      <Rectangle name="Band" y=33 w=86 h=87 bind:w="w" bind:y="33" bind:h="(mixer.h >= 260 ? 33 : 6) + (mixer.h >= 400 ? 54 : (mixer.h >= 350 ? 42 : 22))" bind:fill="track.tint" />
      <Frame name="Input" x=6 w=75 h=16 bind:x="6" bind:y="(33 + (mixer.h >= 260 ? 33 : 6) + 2)" bind:w="min(w - 12, 75)" bind:visible="((w >= 172 ? 86 : w) >= 60) && (mixer.h >= 350 ? true : false) && track.armed" fill="#0a0a0c">
        <Text name="Label" x=3 y=2.5 w=400 h=14 size=10 fill="#a1a1aa" bind:text="track.input">Input</Text>
