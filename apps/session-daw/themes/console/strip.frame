          <Rectangle x=9.97 y=34 w=5.0600000000000005 h=1 fill="#737376" />
          <Rectangle x=9.97 y=36 w=5.0600000000000005 h=1 fill="#757579" />
        </Frame>
        <Rectangle name="Readout" x=33 w=40 h=13 fill="#0a0a0c" bind:y="max(clamp(ph - ph * clamp(track.fader, 0, 1) - min(42.4, ph * 0.5) / 2, 0, max(ph - min(42.4, ph * 0.5), 0)) + min(42.4, ph * 0.5) / 2 - 6.5, 0)" bind:w="track.volume_label_w" bind:visible="ui.pressed == \"fader\"" />
        <Text name="Readout value" x=35 w=400 h=13 size=9 fill="#e4e4e7" bind:y="max(clamp(ph - ph * clamp(track.fader, 0, 1) - min(42.4, ph * 0.5) / 2, 0, max(ph - min(42.4, ph * 0.5), 0)) + min(42.4, ph * 0.5) / 2 - 6.5, 0) + 9 - 7.2 - 1" bind:text="track.volume_label" bind:visible="ui.pressed == \"fader\"">0.0</Text>
        <Rectangle name="Through left" x=10.5 w=4 h=200 bind:h="ph" bind:inset-top="max(((ph - 1) * -clamp(meter.left, 0, 1) + ph - 0.5), (clamp(ph - ph * clamp(track.fader, 0, 1) - min(42.4, ph * 0.5) / 2, 0, max(ph - min(42.4, ph * 0.5), 0)) + min(42.4, ph * 0.5) * 0.24528301886792453))" bind:inset-bottom="ph - min(clamp(ph - ph * clamp(track.fader, 0, 1) - min(42.4, ph * 0.5) / 2, 0, max(ph - min(42.4, ph * 0.5), 0)) + min(42.4, ph * 0.5) * 0.7547169811320755, ph - 0.5)" bind:visible="min(clamp(ph - ph * clamp(track.fader, 0, 1) - min(42.4, ph * 0.5) / 2, 0, max(ph - min(42.4, ph * 0.5), 0)) + min(42.4, ph * 0.5) * 0.7547169811320755, ph - 0.5) - max(((ph - 1) * -clamp(meter.left, 0, 1) + ph - 0.5), (clamp(ph - ph * clamp(track.fader, 0, 1) - min(42.4, ph * 0.5) / 2, 0, max(ph - min(42.4, ph * 0.5), 0)) + min(42.4, ph * 0.5) * 0.24528301886792453)) >= 0.5" fill={[{"kind":{"LinearGradient":{"stops":[{"color":"#22c55e82","position":0},{"color":"#f59e0b82","position":0.75},{"color":"#ef444482","position":1}],"transform":{"a":0,"b":1,"c":-1,"d":0,"tx":0,"ty":1}}}}]} />
        <Rectangle name="Through right" x=15.5 w=3.1000000000000014 h=200 bind:h="ph" bind:inset-top="max(((ph - 1) * -clamp(meter.right, 0, 1) + ph - 0.5), (clamp(ph - ph * clamp(track.fader, 0, 1) - min(42.4, ph * 0.5) / 2, 0, max(ph - min(42.4, ph * 0.5), 0)) + min(42.4, ph * 0.5) * 0.24528301886792453))" bind:inset-bottom="ph - min(clamp(ph - ph * clamp(track.fader, 0, 1) - min(42.4, ph * 0.5) / 2, 0, max(ph - min(42.4, ph * 0.5), 0)) + min(42.4, ph * 0.5) * 0.7547169811320755, ph - 0.5)" bind:visible="min(clamp(ph - ph * clamp(track.fader, 0, 1) - min(42.4, ph * 0.5) / 2, 0, max(ph - min(42.4, ph * 0.5), 0)) + min(42.4, ph * 0.5) * 0.7547169811320755, ph - 0.5) - max(((ph - 1) * -clamp(meter.right, 0, 1) + ph - 0.5), (clamp(ph - ph * clamp(track.fader, 0, 1) - min(42.4, ph * 0.5) / 2, 0, max(ph - min(42.4, ph * 0.5), 0)) + min(42.4, ph * 0.5) * 0.24528301886792453)) >= 0.5" fill={[{"kind":{"LinearGradient":{"stops":[{"color":"#22c55e82","position":0},{"color":"#f59e0b82","position":0.75},{"color":"#ef444482","position":1}],"transform":{"a":0,"b":1,"c":-1,"d":0,"tx":0,"ty":1}}}}]} />
      </Frame>
